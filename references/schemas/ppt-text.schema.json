{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuwen-courseware.local/schemas/ppt-text.schema.json",
  "title": "yuwen-courseware structured PPT text draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "lesson_id", "status", "generated_at", "text_contract_sha256", "ppt_text_sha256", "slides"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ppt-text"},
    "lesson_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "status": {"enum": ["draft", "review", "approved", "invalidated"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "text_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ppt_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "page",
          "title",
          "screen_text",
          "teacher_notes",
          "task_id",
          "objective_ids",
          "script_ids",
          "answer_ids",
          "reveal_state"
        ],
        "properties": {
          "slide_id": {"type": "string", "pattern": "^SLIDE-[0-9]{2,}$"},
          "page": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "screen_text": {"type": "string", "minLength": 1},
          "teacher_notes": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "pattern": "^TASK-[0-9]{2,}$"},
          "objective_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^OBJ-[0-9]{2,}$"}
          },
          "script_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SCRIPT-[0-9]{2,}$"}
          },
          "answer_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^ANS-[0-9]{2,}$"}
          },
          "reveal_state": {
            "enum": ["student-blank", "prompt", "answer", "summary", "neutral"]
          },
          "material_direction": {"type": "string"},
          "information_hierarchy": {"type": "string"},
          "immutable_content": {"type": "string"}
          }
        }
      }
    }
  }
